# ─── Database ───────────────────────────────────────────────
# docker compose up -d  → Postgres 17 + pgvector on 127.0.0.1:54329
DATABASE_URL=postgres://aop:aop_local_dev@127.0.0.1:54329/aop_inbox
# Used only by `pnpm test` (integration suite). Created by db/init.
TEST_DATABASE_URL=postgres://aop:aop_local_dev@127.0.0.1:54329/aop_inbox_test

# ─── Auth (Better Auth) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated emails allowed to create an account. Empty = sign-up closed.
AUTH_ALLOWED_EMAILS=you@example.com
# Dev convenience: `pnpm db:seed` creates this account. Never used in production.
DEV_USER_EMAIL=dev@aop.local
DEV_USER_PASSWORD=aop-dev-password

# ─── AI ─────────────────────────────────────────────────────
# openai | openrouter | local | mock
# "mock" (or an empty AI_API_KEY) runs a deterministic offline analyzer so the
# app is fully usable without a key — summaries are heuristic, not LLM quality.
AI_PROVIDER=openai
AI_API_KEY=
# Optional. Defaults per provider (openai: https://api.openai.com/v1,
# openrouter: https://openrouter.ai/api/v1, local: http://localhost:11434/v1).
AI_BASE_URL=
# Cheap model: per-item analysis / classification.
AI_MODEL=gpt-4.1-mini
# Strong model: Ask Inbox synthesis. Falls back to AI_MODEL.
AI_MODEL_STRONG=gpt-4.1
# Must produce (or be truncated to) 1536 dimensions — see db schema.
AI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Optional integrations ──────────────────────────────────
# Meta oEmbed access token (app-id|client-token). Without it Instagram items are
# saved with URL-only metadata — nothing is scraped.
META_OEMBED_TOKEN=
# Protects POST /api/jobs/run for an external cron / worker trigger.
CRON_SECRET=

# ─── Instagram DM capture (optional; official Messaging API) ─────────
# Users DM Reels to a bot account you own. Setup: docs/instagram-dm.md
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_BOT_USERNAME=
